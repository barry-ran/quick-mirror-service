{
  "openapi": "3.1.0",
  "info": {
    "title": "QuickMirror 设备目录HTTP边界",
    "version": "1.0.0",
    "description": "手机本人上报能力/权限/runtime快照，不作为在线证明。列表与添加使用binding.openapi.json，不提供UUID枚举入口。"
  },
  "security": [
    {
      "InstallationCredential": []
    }
  ],
  "components": {
    "securitySchemes": {
      "InstallationCredential": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "dev_opaque"
      }
    },
    "schemas": {
      "Capability": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "supported": {
            "type": "boolean",
            "default": false
          },
          "available": {
            "type": "boolean",
            "default": false
          },
          "reason": {
            "type": "string",
            "description": "最多256 UTF-8字节；available=true要求supported=true"
          }
        }
      },
      "Status": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "boot_id",
          "seq"
        ],
        "properties": {
          "boot_id": {
            "type": "string",
            "format": "uuid"
          },
          "seq": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "app_version": {
            "type": "string",
            "description": "最多128 UTF-8字节"
          },
          "permissions": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "projection": {
                "type": "boolean",
                "default": false
              },
              "accessibility": {
                "type": "boolean",
                "default": false
              },
              "ime": {
                "type": "boolean",
                "default": false
              }
            }
          },
          "capabilities": {
            "type": "object",
            "maxProperties": 64,
            "additionalProperties": {
              "$ref": "#/components/schemas/Capability"
            }
          },
          "runtime_proof": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$",
            "writeOnly": true,
            "description": "32字节随机base64url无padding，只在控制运行时内存保留；不得日志/回显/安装持久化。"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "request_id",
          "error"
        ],
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "error": {
            "type": "object",
            "required": [
              "code",
              "message",
              "retryable"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "retryable": {
                "type": "boolean"
              },
              "retry_after_ms": {
                "type": "integer"
              }
            }
          }
        }
      }
    }
  },
  "paths": {
    "/qm/v1/device-self/status": {
      "put": {
        "description": "仅手机本人；身份来自安装凭据。PUT完整替换快照，未给权限默认false。不是在线心跳/会话续租。未注册目录404，旧seq/退役boot409。 运行时通过安装凭据逐请求重验来源身份。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Status"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "request_id",
                    "data"
                  ],
                  "properties": {
                    "request_id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "accepted"
                      ],
                      "properties": {
                        "accepted": {
                          "const": true
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "400/401/403/404/409/413/415/429/503；所有层级拒绝重复键，正文最大1MiB，JSON深度32且值/键预算4096。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  }
}
