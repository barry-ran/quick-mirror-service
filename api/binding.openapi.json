  "components": {
    "securitySchemes": {
      "InstallationCredential": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "dev_opaque",
        "description": "Peerloom until_revoked安装凭据，不是管理service key或业务access token。"
      }
    },
    "parameters": {
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128,
          "pattern": "^[^\\r\\n\\u0000]+$"
        },
        "description": "同一操作未知结果按原键原请求重试；成功响应保留24h，过期键返回OUTCOME_UNKNOWN，不重新执行。"
      }
    },
    "schemas": {
      "Relation": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "binding_id": {
            "type": "string",
            "format": "uuid"
          },
          "revision": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,18}$",
            "x-maximum-decimal": "9223372036854775807"
          },
          "pc_id": {
            "type": "string",
            "format": "uuid"
          },
          "mobile_id": {
            "type": "string",
            "format": "uuid"
          },
          "active": {
            "type": "boolean"
          },
          "close_pending": {
            "type": "boolean"
          }
        },
        "required": [
          "binding_id",
          "revision",
          "pc_id",
          "mobile_id",
          "active",
          "close_pending"
        ]
      },
      "Code": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[0-9]{6}$",
            "description": "保留前导零；不是安装认证秘密，不得记录明文日志。"
          },
          "bound": {
            "type": "boolean"
          },
          "binding": {
            "$ref": "#/components/schemas/Relation"
          }
        },
        "required": [
          "bound"
        ],
        "description": "PC始终返回固定码；未绑定手机返回当前码；已绑定手机不返回code，返回bound=true及binding。"
      },
      "Peer": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "device_id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "description": "上游metadata.name或device_name；未提供时为空，客户端本地备注兜底。"
          },
          "online": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "null 为权威 presence 无法确认，不等于离线。"
          }
        },
        "required": [
          "device_id",
          "name",
          "online"
        ]
      },
      "Empty": {
        "type": "object",
        "additionalProperties": false,
        "properties": {},
        "required": []
      },
      "BindRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[0-9]{6}$",
            "description": "保留前导零；不是安装认证秘密，不得记录明文日志。"
          }
        },
        "required": [
          "code"
        ]
      },
      "UnbindRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "expected_revision": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,18}$",
            "x-maximum-decimal": "9223372036854775807"
          }
        },
        "required": [
          "expected_revision"
        ]
      },
      "BatchItem": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "client_item_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "code": {
            "type": "string",
            "pattern": "^[0-9]{6}$",
            "description": "保留前导零；不是安装认证秘密，不得记录明文日志。"
          },
          "operation_key": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128,
            "pattern": "^[^\\r\\n\\u0000]+$"
          }
        },
        "required": [
          "client_item_id",
          "code",
          "operation_key"
        ]
      },
      "ItemError": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "retryable"
        ]
      },
      "Ensure": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[0-9]{6}$",
            "description": "保留前导零；不是安装认证秘密，不得记录明文日志。"
          },
          "bound": {
            "type": "boolean"
          },
          "binding": {
            "$ref": "#/components/schemas/Relation"
          },
          "role": {
            "enum": [
              "pc",
              "mobile"
            ]
          },
          "device_id": {
            "type": "string",
            "format": "uuid"
          },
          "service_scope": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "bound",
          "role",
          "device_id",
          "service_scope"
        ]
      },
      "BindingView": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "binding_id": {
            "type": "string",
            "format": "uuid"
          },
          "revision": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,18}$",
            "x-maximum-decimal": "9223372036854775807"
          },
          "pc_id": {
            "type": "string",
            "format": "uuid"
          },
          "mobile_id": {
            "type": "string",
            "format": "uuid"
          },
          "active": {
            "type": "boolean"
          },
          "close_pending": {
            "type": "boolean"
          },
          "peer": {
            "$ref": "#/components/schemas/Peer"
          }
        },
        "required": [
          "binding_id",
          "revision",
          "pc_id",
          "mobile_id",
          "active",
          "close_pending",
          "peer"
        ]
      },
      "Page": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BindingView"
            },
            "maxItems": 200
          },
          "next_cursor": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "items"
        ]
      },
      "BatchRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 200,
            "items": {
              "$ref": "#/components/schemas/BatchItem"
            }
          }
        },
        "required": [
          "items"
        ]
      },
      "BatchResult": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "client_item_id": {
                      "type": "string"
                    },
                    "binding": {
                      "$ref": "#/components/schemas/Relation"
                    }
                  },
                  "required": [
                    "client_item_id",
                    "binding"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "client_item_id": {
                      "type": "string"
                    },
                    "error": {
                      "$ref": "#/components/schemas/ItemError"
                    }
                  },
                  "required": [
                    "client_item_id",
                    "error"
                  ]
                }
              ]
            }
          }
        },
        "required": [
          "items"
        ]
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "request_id": {
            "type": "string"
          },
          "error": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
                "description": "INVALID_CODE_FORMAT、CODE_INVALID、ROLE_MISMATCH、ALREADY_BOUND_TO_OTHER_PC、NOT_BOUND、BINDING_CHANGED、REFRESH_NOT_ALLOWED、CODE_SPACE_EXHAUSTED、CODE_ALLOCATION_RETRY、IDEMPOTENCY_CONFLICT、AUTH_INVALID、INSTALLATION_FORBIDDEN、UPSTREAM_UNAVAILABLE、OUTCOME_UNKNOWN等。"
              },
              "message": {
                "type": "string"
              },
              "retryable": {
                "type": "boolean"
              }
            },
            "required": [
              "code",
              "message",
              "retryable"
            ]
          }
        },
        "required": [
          "request_id",
          "error"
        ]
      },
      "RelationResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "request_id": {
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/Relation"
          }
        },
        "required": [
          "request_id",
          "data"
        ]
      },
      "CodeResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "request_id": {
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/Code"
          }
        },
        "required": [
