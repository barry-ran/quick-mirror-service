          "data"
        ]
      },
      "EnsureResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "request_id": {
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/Ensure"
          }
        },
        "required": [
          "request_id",
          "data"
        ]
      },
      "PageResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "request_id": {
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/Page"
          }
        },
        "required": [
          "request_id",
          "data"
        ]
      },
      "BatchResultResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "request_id": {
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/BatchResult"
          }
        },
        "required": [
