  "timeline_contract": {
    "status": "实现验收输入，尚未执行；JSON/schema检查不证明运行时资源已释放",
    "cases": [
      {
        "id": "partial_stream_open",
        "steps": [
          "hello成功",
          "mirror.start返回media=1",
          "video open成功",
          "control open失败",
          "video关闭完成",
          "手机VideoLease.awaitDetached完成且encoder退出",
          "Core resourcesDrained"
        ],
        "expect": [
          "媒体代1失效，不能标streaming",
          "关闭已经打开的video child和本机socket",
          "后续迟到control成功立即关闭",
          "逻辑控制会话保持，不能冒充intent free"
        ]
      },
      {
        "id": "start_timeout_unknown",
        "steps": [
          "提交mirror.start request=A",
          "响应丢失达到30秒",
          "state.get确认media=1正在starting",
          "收到A迟到响应"
        ],
        "expect": [
          "UI OUTCOME_UNKNOWN而非确定失败/成功",
          "不得自动重发新request或再分配媒体",
          "只在原owner仍有效时恢复同一预约",
          "已cancel则迟到响应不能attach"
        ]
      },
      {
        "id": "late_permission_after_cancel",
        "steps": [
          "控制会话desired_mirror已设置，系统授权请求在途",
          "mirror.start立即PERMISSION_REQUIRED，未预约媒体",
          "用户cancel清除desired_mirror并关闭原请求owner",
          "系统授权结果迟到成功",
          "原投递队列继续"
        ],
        "expect": [
          "授权可更新全局能力快照，但不能恢复已取消owner或自动重放start",
          "需要仍有效的新desired_mirror和新请求才预约新代",
          "权限不符合时start立即PERMISSION_REQUIRED，不把UI权限流程当已启动"
        ]
      },
      {
        "id": "backpressure_cancel",
        "steps": [
          "媒体1网络write背压未完成",
          "用户stop使media1失效",
          "关闭输出取消/唤醒writer等待",
          "保持codec drain直到VideoLease.awaitDetached完成",
          "encoder/Surface回收并join",
          "Core resourcesDrained"
        ],
        "expect": [
          "SDKclose和QThread.finished均不是手机硬件drained证明",
          "网络write不在UI或共享capture GL线程等待",
          "有界输出满时失败关闭整媒体代，不丢可靠流中间字节",
          "detach前继续消费codec输出，禁止网络背压阻死截图消费者",
          "停止单媒体不销毁共享ProjectionCoordinator授权"
        ]
      },
      {
        "id": "old_media_new_core",
        "steps": [
          "media1进入Closing",
          "请求media2",
          "media1旧video/channelReady回调迟到",
          "media1真实drained",
          "media2独立预约attach"
        ],
        "expect": [
          "media1未drained前不接新Core",
          "旧label/mode/context不能attach media2",
          "每代新writer/socket/token，65+12首部只一次"
        ]
      },
      {
        "id": "active_script_survives",
        "steps": [
          "旧会话启动脚本S并收到真实onStart",
          "旧会话另一命令Q仍在队列未被执行器接纳",
          "close gate与最终执行串行化",
          "输入和媒体owned资源drained",
          "旧runtime提交drained ACK"
        ],
        "expect": [
          "S继续运行，不计入control gate持续inflight",
          "Q必须拒绝，不能因以前通过布尔检查执行",
          "断开不默认调用stopAll，不重放S",
          "显式script.stop的REQUESTED不得提前报告STOPPED"
        ]
      },
      {
        "id": "quit_before_event_loop_exit",
        "steps": [
          "QML close/退出按钮发requestQuit",
          "应用停止新intent/RPC/媒体请求",
          "每设备关闭media/control并等待各owner barriers",
          "共享安装SDK异步shutdown/release完成",
          "允许Qt.quit，app.exec返回"
        ],
        "expect": [
          "关闭期间事件循环/SDK存储与callback仍可服务",
          "重复退出请求共享同一Closing过程",
          "任何drain未知则保留owner并显示未完成，不强杀/同步析构替代",
          "不以aboutToQuit或app.exec返回后的disconnect启动正常异步收尾"
        ]
      }
    ]
  }
}
